# 1. Variables de entorno y credenciales sensibles
.env
.env.*

# 2. Dependencias de Composer
/vendor/

# 3. Registros de ejecución (Logs) y candados de concurrencia
/logs/**/*.log
/logs/*.log
/logs/*.lock

# 4. Archivos temporales y de depuración
*.tmp
*.bak
error_log
php_errors.log

# 5. Archivos del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# 6. Entornos de desarrollo y configuración local de IDEs
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources.local.xml
.vscode/*
!.vscode/settings.json
